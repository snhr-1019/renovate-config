{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Asia/Tokyo",
  "schedule": "before 6am on saturday",
  "reviewers": [
    "@snhr-1019"
  ],
  "labels": [
    "dependencies"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.chezmoiexternal\\.toml(\\.tmpl)?$"],
      "matchStrings": [
        "url\\s*=\\s*\"https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/v?(?<currentValue>[\\d.]+)/[^\"]*\""
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dependencies non-major",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "custom regex",
      "automerge": true,
      "platformAutomerge": true,
      "schedule": ["at any time"]
    },
    {
      // mise は Corretto を独自表記 (corretto-17.0.20.10.1) で扱うが、
      // Renovate は Amazon 公式の表記 (17.0.20+101) を書き込むため、
      // mise が `no metadata found for version` で解決できなくなる。
      // java は更新対象から外し、手動で更新する。
      "matchDepNames": ["java"],
      "enabled": false
    },
    {
      "matchDepNames": ["node"],
      "groupName": "node"
    },
    {
      "matchDepNames": ["python"],
      "groupName": "python"
    }
  ]
}
